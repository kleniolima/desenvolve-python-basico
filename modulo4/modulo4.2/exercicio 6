# Inicializa as variáveis sem nenhum valor

maior = None
menor = None

# Repete a leitura dos valores indefinidamente

while True:
    # Lê um valor inteiro digitado pelo usuário
    valor = int(input())

    # Se o valor for 0, encerra a leitura
    if valor == 0:
        break

    # Verifica se é o primeiro valor ou se é maior que o maior atual
    if maior is None or valor > maior:
        maior = valor

    # Verifica se é o primeiro valor ou se é menor que o menor atual
    if menor is None or valor < menor:
        menor = valor

# Exibe o maior valor digitado
print(f"Maior: {maior}")

# Exibe o menor valor digitado
print(f"Menor: {menor}")
